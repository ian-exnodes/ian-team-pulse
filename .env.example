# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Either the legacy "anon" JWT or the new "sb_publishable_..." key works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: restrict signups to one email domain (e.g. mycompany.com).
# Leave empty to let anyone sign up.
# IMPORTANT: this env var only powers the friendly client-side check.
# Server-side enforcement lives in the database - set it together with:
#   update public.app_config set allowed_email_domain = 'mycompany.com';
# (see README "Restricting signups"). The two values must match.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=

# --- Jira import (optional, off by default) ---
# Show the "Jira" button and enable the import UI. Leave unset/false to keep
# the feature hidden in the deployed app (the code stays dormant). Set to
# true locally to develop/test it.
NEXT_PUBLIC_JIRA_ENABLED=

# Server-only secrets - NO NEXT_PUBLIC_ prefix, never exposed to the browser.
# Only needed if you enable "Import from Jira" (see README "Importing from Jira").
# From your Atlassian OAuth 2.0 (3LO) app at developer.atlassian.com:
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Supabase service-role key (Project Settings -> API -> service_role).
# Grants full DB access - keep it server-only and secret.
SUPABASE_SERVICE_ROLE_KEY=
